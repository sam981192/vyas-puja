{
  "entities": {
    "Offering": {
      "title": "Offering",
      "description": "A Vyas Puja offering submitted by a devotee",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "language": { "type": "string" },
        "state": { "type": "string" },
        "city": { "type": "string" },
        "name": { "type": "string" },
        "contact": { "type": "string" },
        "formatType": { "type": "string", "enum": ["text", "audio", "image", "document", "ppt"] },
        "textContent": { "type": "string" },
        "fileName": { "type": "string" },
        "fileIndex": { "type": "integer" },
        "totalFiles": { "type": "integer" },
        "submitterUid": { "type": "string" }
      },
      "required": ["timestamp", "language", "state", "city", "name", "contact", "formatType"]
    }
  },
  "firestore": {
    "offerings/{offeringId}": {
      "schema": "Offering",
      "description": "Collection of all Vyas Puja offerings"
    }
  }
}
